# Sirens Forge environment example
# -----------------------------------------------------------------------------
# Placeholder values are examples only. Do not commit real secrets, real tokens,
# real bucket credentials, or private account IDs.
#
# Configure Vercel, Railway/API, and RunPod with only the variables each runtime
# needs. Keep server-side secrets out of NEXT_PUBLIC_* variables.

# -----------------------------------------------------------------------------
# Public app config (safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me_supabase_anon_key

# -----------------------------------------------------------------------------
# Supabase server-side (server/runtime only)
# -----------------------------------------------------------------------------
# Used by API routes, Stripe customer lookup, generation logging, LoRA cache
# lookup, and the RunPod trainer.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me


# -----------------------------------------------------------------------------
# X / Twitter Autopost OAuth (server/runtime only)
# -----------------------------------------------------------------------------
# Text-only MVP. Verify requested scopes in the X Developer portal before production.
# Do not request media.write until the media upload pass.
X_CLIENT_ID=replace_me_x_client_id
X_CLIENT_SECRET=replace_me_x_client_secret
X_REDIRECT_URI=https://example.com/api/autopost/connect/x/callback
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access
X_API_BASE_URL=https://api.x.com

# Server-only, comma-separated Supabase user UUIDs required for access to
# /api/admin/autopost/x/*. Intentionally empty so admin routes fail closed by default.
AUTOPOST_X_ADMIN_USER_IDS=

# Autopost provider credential encryption and OAuth state signing (server/runtime only).
# AUTOPOST_TOKEN_ENCRYPTION_KEY must be a base64-encoded 32-byte key.
AUTOPOST_TOKEN_ENCRYPTION_KEY=replace_me_base64_32_byte_key
AUTOPOST_TOKEN_KEY_VERSION=1
AUTOPOST_OAUTH_STATE_SECRET=replace_me_random_oauth_state_secret

# Internal server-to-server adapter auth. Never expose this to browsers.
AUTOPOST_INTERNAL_ADAPTER_SECRET=replace_me_random_internal_adapter_secret

# Canonical server-side authentication secret for /api/autopost/run.
# Production must assign CRON_SECRET for the X-08 configuration posture.
# The runner also accepts VERCEL_CRON_SECRET as a fallback, but X-08 verifies
# the canonical CRON_SECRET assignment rather than relying on that fallback.
# No cron is currently configured in vercel.json. Configuring this secret does
# not authorize runner invocation, cron creation, X dispatch, or posting to X.
# Never commit a real value, paste it into ChatGPT, expose it in screenshots,
# or print it in logs. The value below is a fake placeholder only.
CRON_SECRET=replace_me_high_entropy_runner_secret
# Existing Creator Publishing scheduler gate. Exact lowercase "true" is required.
CREATOR_PUBLISHING_SCHEDULER_ENABLED=false
# Explicit staging/internal gate for /api/autopost/run dispatch. Keep false unless manually testing server-side dispatch.
AUTOPOST_X_RUN_DISPATCH_ENABLED=false

# -----------------------------------------------------------------------------
# Fanvue Autopost OAuth (server/runtime only; gated OFF by default)
# -----------------------------------------------------------------------------
FANVUE_CONNECT_ENABLED=false
FANVUE_RUN_DISPATCH_ENABLED=false
FANVUE_POST_VERIFY_ENABLED=false
# Final public Fanvue selector/scheduling latch. Exact lowercase "true" is required.
FANVUE_PUBLIC_ACTIVATION_ENABLED=false
# Final CPQ provider-worker latch. Requires the public activation and scheduler gates too.
FANVUE_CPQ_WORKER_ENABLED=false
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# FANVUE_OAUTH_CLIENT_AUTH_METHOD=body
FANVUE_REDIRECT_URI=https://example.com/api/autopost/connect/fanvue/callback
# Final provider acceptance (including write:creator) and live activation must be verified separately.
FANVUE_OAUTH_SCOPES=openid offline_access offline read:self read:creator read:post write:post read:media write:media write:creator
FANVUE_API_BASE_URL=
FANVUE_OAUTH_AUTHORIZE_URL=
FANVUE_OAUTH_TOKEN_URL=
FANVUE_API_VERSION=

# Server-side image execution gate. Only exact lowercase "true" permits dispatch.
GENERATION_EXECUTION_ENABLED=false

# -----------------------------------------------------------------------------
# Stripe (server/runtime only)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=replace_me_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_me_stripe_webhook_secret

# Checkout subscription price IDs are read from env overrides by tier slug.
# Leave blank unless this environment should create Stripe Checkout sessions for
# that tier. Do not put live price IDs here unless this file remains local only.
STRIPE_PRICE_OG_THRONE=replace_me
STRIPE_PRICE_EARLY_BIRD=replace_me
STRIPE_PRICE_PRIME_ACCESS=replace_me

# -----------------------------------------------------------------------------
# Railway/API / generation gateway
# -----------------------------------------------------------------------------
# app/api/generate forwards generation requests to this gateway.
SIRENS_API_BASE_URL=https://example-railway-api.example.com
# Server-only credential used by Next.js when calling sirens-forge-api.
SIRENS_API_INTERNAL_SECRET=

# -----------------------------------------------------------------------------
# R2 / S3-compatible storage
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Shared/legacy credentials for existing non-private R2 consumers.
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me

# Region defaults vary by runtime. App upload routes use AWS_DEFAULT_REGION;
# start-training uses R2_REGION; the trainer reads AWS_DEFAULT_REGION.
AWS_DEFAULT_REGION=auto
R2_REGION=auto

# R2_BUCKET is the default/shared bucket fallback used by app routes and legacy
# paths. Dataset Doctor raw uploads use R2_BUCKET in the master/frontend upload
# URL route.
R2_BUCKET=identity-loras

# Trainer dataset download fallback. Dataset Doctor final dataset bucket/prefix
# come from the API/Railway Dataset Doctor export and are stored into Supabase
# fields; the trainer uses those stored fields first when present.
R2_DATASET_BUCKET=replace_me_dataset_bucket
R2_DATASET_PREFIX_ROOT=lora_datasets

# Trainer artifact upload bucket/prefix. Generation LoRA cache prefers
# user_loras.artifact_r2_bucket, then falls back to R2_BUCKET, then
# "identity-loras".
R2_ARTIFACT_BUCKET=replace_me_artifact_bucket
R2_ARTIFACT_PREFIX_ROOT=loras

# -----------------------------------------------------------------------------
# RunPod LoRA trainer
# -----------------------------------------------------------------------------
PRETRAINED_MODEL=/workspace/models/replace_me_model.safetensors
VAE_PATH=/workspace/models/replace_me_vae.safetensors
LORA_LOCAL_TRAIN_ROOT=/workspace/train_data
LORA_OUTPUT_ROOT=/workspace/output_loras
TRAIN_SCRIPT=/workspace/sd-scripts/sdxl_train_network.py
PYTHON_BIN=/usr/bin/python3
LORA_NETWORK_MODULE=networks.lora
LORA_CONCEPT_TOKEN=concept
LORA_CAPTION_EXTENSION=.txt
LORA_USE_BLIP_CAPTIONS=1
LORA_BLIP_MODEL_ID=Salesforce/blip-image-captioning-base
LORA_TRIGGER_SUFFIX=woman
LORA_CAPTION_STYLE_PREFIX=
LORA_NOTIFY_ENDPOINT=https://example.supabase.co/functions/v1/lora-status-notify

# Creator Publishing Queue private media bucket (server-side signed URLs only)
CREATOR_PUBLISHING_MEDIA_BUCKET=creator-publishing-media
CREATOR_PUBLISHING_MEDIA_MAX_UPLOAD_BYTES=52428800

# P0-02A private creator-generation media cutover. Server-only; exact "true"
# enables. Keep false until the API follow-up, private bucket, migration, and
# canary are separately authorized and complete.
# Master/Vercel uses a separate bucket-scoped Object Read-only token for
# HeadObject, GetObject, and presigned GetObject. These values are server-only,
# have no generic R2 credential fallback, and must never use NEXT_PUBLIC_ names.
PRIVATE_CREATOR_MEDIA_ENABLED=false
CREATOR_GENERATION_R2_ACCESS_KEY_ID=
CREATOR_GENERATION_R2_SECRET_ACCESS_KEY=
CREATOR_GENERATION_R2_BUCKET=sirens-creator-generations-private

# -----------------------------------------------------------------------------
# Payment-First V2 (server gates are disabled by default)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com
# Production canonical origin: https://www.sirensforge.vip
PAYMENT_FIRST_CHECKOUT_V2_RETURN_ORIGIN=https://example.com
# Placeholder only. Never commit a real Stripe signing secret.
STRIPE_PAYMENT_V2_WEBHOOK_SECRET=replace_me_payment_v2_webhook_secret
# Every Payment-First gate enables only with the exact lowercase value "true".
PAYMENT_FIRST_PUBLIC_CUTOVER_V2_ENABLED=false
PAYMENT_FIRST_CHECKOUT_V2_ENABLED=false
# Keep false until BotID is verified and the Vercel Firewall fixed-window rule
# payment-v2-checkout is published: 10 requests/10 minutes/source IP, HTTP 429,
# first validated in Preview or logging posture.
PAYMENT_FIRST_CHECKOUT_V2_PROTECTION_ENABLED=false
PAYMENT_FIRST_WEBHOOK_V2_ENABLED=false
# Server-only dormant PFC-07E-A1 inbox gate. Only exact lowercase "true"
# permits durable receipt of recognized future lifecycle events; this does not
# enable A2 refund, A3 subscription, or PFC-07E-B dispute processing.
PAYMENT_V2_EVENT_INBOX_ENABLED=false
PAYMENT_FIRST_CLAIM_V2_ENABLED=false
PAYMENT_FIRST_SUCCESS_V2_ENABLED=false
PAYMENT_FIRST_AUTH_CONTINUATION_V2_ENABLED=false
# Server-only staged durable compute control plane. Default OFF; exact lowercase true only.
DURABLE_COMPUTE_JOBS_ENABLED=false

# Phase 4 Video application. Server-only and fail-closed; provider/runtime remains disabled.
VIDEO_GENERATION_ENABLED=false
# Dedicated staging/final source-image write credential; never fall back to generic R2 keys.
CREATOR_GENERATION_R2_UPLOAD_ACCESS_KEY_ID=
CREATOR_GENERATION_R2_UPLOAD_SECRET_ACCESS_KEY=
# Exact true only after private bucket CORS and staging lifecycle are manually verified.
VIDEO_SOURCE_UPLOAD_INFRA_READY=false
# Server-only OpenAI-compatible prompt engine (never expose with NEXT_PUBLIC_)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
# Optional server-only conversational model overrides (defaults retain current routing)
SIRENS_MIND_SAFE_MODEL=
SIRENS_MIND_NSFW_MODEL=
SIRENS_MIND_ULTRA_MODEL=
